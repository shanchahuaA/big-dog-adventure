{
	"schemaVersion": 1,
	"id": "big-dog-adventure",
	"version": "${version}",
	"name": "Big Dog Adventure",
	"description": "A very loud dog, spell-casting chickens and enchanted horses — what could go wrong?",
	"authors": [
		"shanchahuaA"
	],
	"contact": {
		"homepage": "https://github.com/shanchahuaA/big-dog-adventure",
		"issues": "https://github.com/shanchahuaA/big-dog-adventure/issues",
		"sources": "https://github.com/shanchahuaA/big-dog-adventure"
	},
	"license": "MIT",
	"icon": "assets/big-dog-adventure/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mymod.bigdog.BigDogMod"
		],
		"client": [
			"com.mymod.bigdog.client.BigDogModClient"
		],
		"fabric-datagen": [
			"com.mymod.bigdog.client.BigDogModDataGenerator"
		]
	},
	"mixins": [
		"big-dog-adventure.mixins.json",
		{
			"config": "big-dog-adventure.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	}
}